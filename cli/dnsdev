#!/usr/bin/env bash
# dnsdev — จัดการ local dev DNS (dnsmasq + /etc/resolver) ให้จบในคำสั่งเดียว
#
# ปัญหาที่ตัวนี้แก้: การเพิ่มโดเมนต้องแตะ 2 ที่เสมอ — zone file ของ dnsmasq
# กับ /etc/resolver/ ของ macOS ถ้าลืมอย่างหลัง dnsmasq จะตอบถูกทุกอย่างแต่
# ระบบไม่เคยส่ง query มาให้เลย แล้วดีบักไม่เจอเพราะ dig ธรรมดาก็ไม่ฟ้อง
#
# รองรับทั้ง Intel (/usr/local) และ Apple Silicon (/opt/homebrew)

set -uo pipefail

# ---------- หา Homebrew prefix ให้ทำงานได้ทั้งสองสถาปัตยกรรม ----------
PREFIX=""
for p in "$(brew --prefix 2>/dev/null)" /opt/homebrew /usr/local; do
  [ -n "$p" ] && [ -f "$p/etc/dnsmasq.conf" ] && { PREFIX="$p"; break; }
done
if [ -z "$PREFIX" ]; then
  for p in "$(brew --prefix 2>/dev/null)" /opt/homebrew /usr/local; do
    [ -n "$p" ] && [ -x "$p/sbin/dnsmasq" ] && { PREFIX="$p"; break; }
  done
fi
[ -z "$PREFIX" ] && { echo "หา dnsmasq ไม่เจอ — ลง 'brew install dnsmasq' ก่อน" >&2; exit 1; }

CONF="$PREFIX/etc/dnsmasq.conf"
ZONED="$PREFIX/etc/dnsmasq.d"
BIN="$PREFIX/sbin/dnsmasq"
RESOLVER="/etc/resolver"
SERVICE="homebrew.mxcl.dnsmasq"

B=$'\033[1m'; R=$'\033[31m'; G=$'\033[32m'; Y=$'\033[33m'; D=$'\033[2m'; N=$'\033[0m'
ok(){ printf "%s✓%s %s\n" "$G" "$N" "$*"; }
warn(){ printf "%s!%s %s\n" "$Y" "$N" "$*"; }
err(){ printf "%s✗%s %s\n" "$R" "$N" "$*" >&2; }
info(){ printf "%s%s%s\n" "$D" "$*" "$N"; }

# ---------- helper ----------

# หา /etc/resolver ที่ครอบโดเมนนี้ (macOS จับคู่แบบ suffix ยาวสุด)
resolver_for() {
  local probe="$1"
  while [ -n "$probe" ]; do
    [ -f "$RESOLVER/$probe" ] && { echo "$probe"; return 0; }
    case "$probe" in *.*) probe="${probe#*.}";; *) break;; esac
  done
  return 1
}

tld_of() { echo "${1##*.}"; }
zone_file() { echo "$ZONED/$(echo "$1" | tr '.' '_').conf"; }

check_tld() {
  case "$(tld_of "$1")" in
    local)
      err ".local ใช้กับ dnsmasq ไม่ได้ — macOS ส่งไป mDNSResponder (Bonjour) เสมอ"
      err "   query จะไม่มีทางมาถึง dnsmasq  แนะนำใช้ .test แทน"
      return 1;;
    dev)
      warn ".dev เป็น gTLD จริงของ Google อยู่ใน HSTS preload"
      warn "   browser จะบังคับ https ต้องมี cert ไม่งั้นเปิดไม่ได้";;
    localhost)
      warn ".localhost macOS resolve ให้เองอยู่แล้วทุก subdomain"
      warn "   ไม่ต้องใช้ dnsmasq เลยก็ได้ (แต่จะบังคับเป็น 127.0.0.1 เท่านั้น)";;
    test) ;;
    *)
      warn "$(tld_of "$1") ไม่ใช่ TLD ที่สงวนไว้ อาจถูกขายเป็นโดเมนจริงในอนาคต"
      warn "   .test สงวนถาวรตาม RFC 6761 ปลอดภัยกว่า";;
  esac
  return 0
}

hosts_shadow() {
  grep -vE '^\s*#' /etc/hosts 2>/dev/null \
    | awk '{for(i=2;i<=NF;i++) print $i}' \
    | grep -E "(^|\.)$(echo "$1" | sed 's/\./\\./g')$" | sort -u
}

syntax_ok() { "$BIN" --test -C "$CONF" -7 "$ZONED",'*.conf' >/dev/null 2>&1; }

reload() {
  syntax_ok || { err "config มี syntax error — ไม่ restart"; "$BIN" --test -C "$CONF" -7 "$ZONED",'*.conf'; return 1; }
  sudo launchctl kickstart -k "system/$SERVICE" 2>/dev/null \
    || sudo brew services restart dnsmasq >/dev/null 2>&1 \
    || { err "restart dnsmasq ไม่สำเร็จ"; return 1; }
  sudo dscacheutil -flushcache 2>/dev/null
  sudo killall -HUP mDNSResponder 2>/dev/null
  ok "restart dnsmasq + flush cache แล้ว"
}

# ---------- commands ----------

cmd_add() {
  local mode="terminate"
  [ "${1:-}" = "--pass" ] && { mode="passthrough"; shift; }
  local domain="${1:-}" target="${2:-}"
  [ -z "$domain" ] && { err "ต้องระบุโดเมน:  dnsdev add <domain> [port|ip|host:port]"; exit 1; }
  domain="${domain#.}"; domain="${domain%.}"

  # เลข = พอร์ต, IP = ชี้ DNS ตรง ๆ เหมือนเดิม, host:port = ให้ proxy ส่งต่อ
  local kind dest ip route_to=""
  read -r kind dest <<<"$(classify_target "$target")"
  [ "$kind" = "invalid" ] && { err "ไม่เข้าใจปลายทาง: $target"; exit 1; }
  if [ "$kind" = "proxy" ]; then ip="127.0.0.1"; route_to="$dest"; else ip="$dest"; fi
  [ "$mode" = "passthrough" ] && [ -z "$route_to" ] && {
    err "--pass ต้องบอกปลายทางด้วย เช่น:  dnsdev add --pass vm.test 127.0.0.1:8443"; exit 1; }

  check_tld "$domain" || exit 1

  local zf; zf="$(zone_file "$domain")"
  [ -f "$zf" ] && warn "มีอยู่แล้ว จะเขียนทับ: $zf"

  cat > "$zf" <<EOF
# $domain — wildcard ครอบทุก subdomain ทุกชั้น
# สร้างโดย dnsdev เมื่อ $(date '+%Y-%m-%d %H:%M:%S')
address=/$domain/$ip
EOF
  ok "zone:     $zf"
  info "          address=/$domain/$ip"

  local tld; tld="$(tld_of "$domain")"
  if existing="$(resolver_for "$domain")"; then
    ok "resolver: /etc/resolver/$existing (มีอยู่แล้ว ครอบโดเมนนี้)"
  else
    echo "nameserver 127.0.0.1" | sudo tee "$RESOLVER/$tld" >/dev/null \
      && ok "resolver: /etc/resolver/$tld (สร้างใหม่)" \
      || { err "สร้าง /etc/resolver/$tld ไม่สำเร็จ"; exit 1; }
    info "          ครั้งหน้าเพิ่มโดเมน .$tld อื่นจะไม่ต้อง sudo อีก"
  fi

  local shadow; shadow="$(hosts_shadow "$domain")"
  if [ -n "$shadow" ]; then
    echo
    warn "/etc/hosts มีบรรทัดที่ทับโดเมนนี้อยู่ — hosts ชนะ DNS เสมอ"
    warn "subdomain ที่ไม่ได้ระบุไว้ในนั้นจะยังใช้ไม่ได้:"
    echo "$shadow" | sed 's/^/      /'
    warn "ลบออกด้วย:  sudo sed -i '' '/$(echo "$domain" | sed 's/\./\\./g')/d' /etc/hosts"
  fi

  if [ -n "$route_to" ]; then
    routes_edit "$domain" "$route_to" "$mode"
    if [ "$mode" = "passthrough" ]; then
      ok "proxy:    https://$domain → $route_to  (passthrough — ปลายทางถือ cert เอง)"
    else
      ok "proxy:    https://$domain → $route_to"
      info "          subdomain ทุกชั้นใช้ปลายทางเดียวกัน ไม่ต้องเพิ่มอีก"
    fi
    proxy_running || warn "          แต่ dnsdevd ยังไม่ได้รัน — 'dnsdev proxy install'"
  fi

  echo
  reload && { echo; cmd_test "$domain"; }
}

cmd_rm() {
  local domain="${1:-}"
  [ -z "$domain" ] && { err "ต้องระบุโดเมน:  dnsdev rm <domain>"; exit 1; }
  local zf; zf="$(zone_file "$domain")"
  [ -f "$zf" ] || { err "ไม่มี zone นี้: $domain"; exit 1; }

  rm -f "$zf" && ok "ลบ zone: $zf"
  if route_of "$domain" >/dev/null 2>&1; then
    routes_edit "$domain" "" ""; ok "ลบ route ของ proxy ด้วย"
  fi

  # ลบ resolver ก็ต่อเมื่อไม่มี zone ไหนใช้ TLD นี้แล้ว
  local tld; tld="$(tld_of "$domain")"
  if [ -f "$RESOLVER/$tld" ]; then
    if ! grep -hoE '^address=/[^/]+/' "$ZONED"/*.conf 2>/dev/null \
         | sed 's|^address=/||; s|/$||' | grep -qE "\.$tld$|^$tld$"; then
      sudo rm -f "$RESOLVER/$tld" && ok "ลบ /etc/resolver/$tld (ไม่มี zone ไหนใช้ .$tld แล้ว)"
    else
      info "เก็บ /etc/resolver/$tld ไว้ — ยังมี zone อื่นใช้ .$tld อยู่"
    fi
  fi
  echo; reload
}

cmd_ls() {
  shopt -s nullglob
  local files=("$ZONED"/*.conf)
  if [ ${#files[@]} -eq 0 ]; then
    info "ยังไม่มี zone — เพิ่มด้วย:  dnsdev add foo.test"
    return
  fi
  printf "%s%-30s %-14s %-22s %s%s\n" "$B" "DOMAIN" "→ IP" "PROXY (https)" "RESOLVER" "$N"
  for f in "${files[@]}"; do
    while IFS= read -r line; do
      local d ip rs rt to md px
      d="$(echo "$line" | sed 's|^address=/||; s|/[^/]*$||')"
      ip="$(echo "$line" | sed 's|.*/||')"
      if rs="$(resolver_for "$d")"; then rs="${G}resolver/$rs${N}"
      else rs="${R}ไม่มี — ใช้ไม่ได้!${N}"; fi
      if rt="$(route_of "$d" 2>/dev/null)"; then
        to="${rt%%	*}"; md="${rt##*	}"
        [ "$md" = "passthrough" ] && px="$to ${D}(pass)${N}" || px="$to"
      else px="${D}—${N}"; fi
      printf "%-30s %-14s %-22b %b\n" "$d" "$ip" "$px" "$rs"
    done < <(grep -hE '^address=/' "$f" 2>/dev/null)
  done
  proxy_running || { echo; info "dnsdevd ไม่ได้รัน — คอลัมน์ PROXY ยังไม่มีผล ('dnsdev proxy install')"; }
}

cmd_test() {
  local domain="${1:-}"
  [ -z "$domain" ] && { err "ต้องระบุโดเมน:  dnsdev test <domain>"; exit 1; }
  # ยิง subdomain สุ่มด้วย เพื่อพิสูจน์ว่า wildcard ทำงานจริง ไม่ใช่แค่ hosts file
  local probe="wildcard-check-$RANDOM.$domain"
  printf "%s%s%s\n" "$B" "ทดสอบ 2 ชั้น" "$N"

  local a1; a1="$(dig +short +time=2 +tries=1 @127.0.0.1 "$probe" 2>/dev/null | head -1)"
  if [ -n "$a1" ]; then ok "ชั้น dnsmasq  $probe → $a1"
  else err "ชั้น dnsmasq  ไม่ตอบ — zone ไม่ถูกโหลด (restart แล้วหรือยัง?)"; fi

  local a2; a2="$(dscacheutil -q host -a name "$probe" 2>/dev/null | awk '/^ip_address/{print $2; exit}')"
  if [ -n "$a2" ]; then ok "ชั้นระบบ     $probe → $a2"
  else
    err "ชั้นระบบ     ไม่ตอบ — macOS ไม่ได้ส่ง query มาที่ dnsmasq"
    resolver_for "$domain" >/dev/null || err "             สาเหตุ: ไม่มี /etc/resolver/$(tld_of "$domain")"
  fi
  [ -n "$a1" ] && [ -n "$a2" ] && { echo; ok "${B}ใช้งานได้จริง${N} — subdomain ใหม่ใช้ได้ทันทีไม่ต้องตั้งอะไรเพิ่ม"; }
}

cmd_doctor() {
  printf "%s%s%s\n" "$B" "═══ dnsdev doctor ═══" "$N"
  info "prefix: $PREFIX   ($(uname -m))"
  echo

  pgrep -f "$PREFIX/.*dnsmasq" >/dev/null \
    && ok "dnsmasq กำลังรัน (pid $(pgrep -f "$PREFIX/.*dnsmasq" | head -1))" \
    || err "dnsmasq ไม่ได้รัน —  sudo brew services start dnsmasq"

  syntax_ok && ok "config syntax ผ่าน" || err "config syntax ผิด —  $BIN --test -C $CONF"

  grep -qE '^\s*conf-dir=' "$CONF" \
    && ok "conf-dir ชี้ไป dnsmasq.d/ แล้ว" \
    || err "$CONF ไม่มี conf-dir= — ไฟล์ใน dnsmasq.d/ จะไม่ถูกอ่านเลย"
  echo

  printf "%s%s%s\n" "$B" "── zones ──" "$N"; cmd_ls
  echo

  printf "%s%s%s\n" "$B" "── /etc/resolver ที่ไม่มี zone รองรับ ──" "$N"
  local orphan=0
  shopt -s nullglob
  for rf in "$RESOLVER"/*; do
    local name; name="$(basename "$rf")"
    if ! grep -hoE '^address=/[^/]+/' "$ZONED"/*.conf 2>/dev/null \
         | sed 's|^address=/||; s|/$||' | grep -qE "(^|\.)$(echo "$name" | sed 's/\./\\./g')$"; then
      warn "$name — query จะวิ่งไป dnsmasq แล้ว forward ออก internet เปล่า ๆ (ทำให้ช้า)"
      orphan=1
    fi
  done
  [ $orphan -eq 0 ] && ok "ไม่มี resolver กำพร้า"
  echo

  printf "%s%s%s\n" "$B" "── /etc/hosts ที่ทับ zone ──" "$N"
  local conflict=0
  while IFS= read -r d; do
    local s; s="$(hosts_shadow "$d")"
    [ -n "$s" ] && { warn "$d ถูกทับโดย: $(echo "$s" | tr '\n' ' ')"; conflict=1; }
  done < <(grep -hoE '^address=/[^/]+/' "$ZONED"/*.conf 2>/dev/null | sed 's|^address=/||; s|/$||')
  [ $conflict -eq 0 ] && ok "ไม่มี /etc/hosts ทับ zone ไหน"
}

# ---------- ชั้น proxy (https ไม่ต้องพิมพ์พอร์ต) ----------
# DNS อย่างเดียวพาไปได้แค่ "โดเมนนี้คือเครื่องไหน" ยังต้องพิมพ์ :3000 อยู่ดี
# ชั้นนี้คือ dnsdevd — ฟัง :443 แล้วส่งต่อตามชื่อ พร้อมออก cert ให้เอง
STATE="$HOME/.config/dnsdev"
ROUTES="$STATE/routes.json"
CA_PEM="$STATE/ca/ca.pem"
AGENT_LABEL="local.dnsdev.proxy"
AGENT_PLIST="$HOME/Library/LaunchAgents/$AGENT_LABEL.plist"
DAEMON_INSTALLED="$HOME/.local/libexec/dnsdevd"
PROXY_LOG="$STATE/proxy.log"

# หา dnsdevd: ตัวที่ติดตั้งแล้วมาก่อน แล้วค่อยไล่หาในรีโป (ตอน dev)
find_daemon() {
  local self here
  self="$(cd "$(dirname "$0")" && pwd)"
  for c in "$DAEMON_INSTALLED" "$self/../proxy/dnsdevd" "$self/proxy/dnsdevd"; do
    [ -x "$c" ] && { cd "$(dirname "$c")" && echo "$PWD/$(basename "$c")"; return 0; }
  done
  return 1
}

py() { /usr/bin/env python3 "$@"; }

routes_edit() {   # routes_edit <host> <to|""> <mode>   — to ว่าง = ลบ
  mkdir -p "$STATE"
  DNSDEV_HOST="$1" DNSDEV_TO="$2" DNSDEV_MODE="$3" DNSDEV_FILE="$ROUTES" py - <<'PY'
import json, os, tempfile
f = os.environ["DNSDEV_FILE"]
host, to, mode = os.environ["DNSDEV_HOST"], os.environ["DNSDEV_TO"], os.environ["DNSDEV_MODE"]
try:
    with open(f) as fh: cfg = json.load(fh)
except Exception:
    cfg = {}
cfg.setdefault("https", 443)
cfg.setdefault("http", 80)
routes = [r for r in cfg.get("routes", []) if r.get("host") != host]
if to:
    r = {"host": host, "to": to}
    if mode == "passthrough": r["mode"] = "passthrough"
    routes.append(r)
cfg["routes"] = sorted(routes, key=lambda r: r["host"])
# เขียนใหม่แล้ว rename ทับ — daemon เฝ้าโฟลเดอร์อยู่ จะเห็นครั้งเดียวจบ
d = os.path.dirname(f) or "."
os.makedirs(d, exist_ok=True)
fd, tmp = tempfile.mkstemp(dir=d)
with os.fdopen(fd, "w") as fh: json.dump(cfg, fh, indent=2, ensure_ascii=False); fh.write("\n")
os.replace(tmp, f)
PY
}

route_of() {      # route_of <host> -> "to<TAB>mode" ถ้ามี
  [ -f "$ROUTES" ] || return 1
  DNSDEV_HOST="$1" DNSDEV_FILE="$ROUTES" py - <<'PY'
import json, os, sys
try:
    with open(os.environ["DNSDEV_FILE"]) as fh: cfg = json.load(fh)
except Exception: sys.exit(1)
for r in cfg.get("routes", []):
    if r.get("host") == os.environ["DNSDEV_HOST"]:
        print("%s\t%s" % (r.get("to", ""), r.get("mode", "terminate"))); sys.exit(0)
sys.exit(1)
PY
}

proxy_running() { pgrep -qf "$DAEMON_INSTALLED" 2>/dev/null; }

proxy_ports() {   # อ่านพอร์ตจาก config (default 443/80)
  DNSDEV_FILE="$ROUTES" py - <<'PY'
import json, os
try:
    with open(os.environ["DNSDEV_FILE"]) as fh: cfg = json.load(fh)
except Exception: cfg = {}
print("%s %s" % (cfg.get("https", 443), cfg.get("http", 80)))
PY
}

# แปลง argument ตัวที่สองของ add ให้รู้ว่าหมายถึงอะไร
# 3000            -> proxy ไป 127.0.0.1:3000
# 10.0.0.9        -> DNS ชี้ IP นั้นตรง ๆ (พฤติกรรมเดิม)
# 10.0.0.9:8080   -> proxy ไปที่นั่น
is_port() { case "$1" in ""|*[!0-9]*) return 1;; esac; [ "$1" -ge 1 ] && [ "$1" -le 65535 ]; }

is_ipv4() {
  local IFS=. o n=0
  case "$1" in ""|*[!0-9.]*|*..*|.*|*.) return 1;; esac
  for o in $1; do
    [ "${#o}" -gt 3 ] && return 1
    [ "$o" -gt 255 ] && return 1
    n=$((n+1))
  done
  [ "$n" -eq 4 ]
}

classify_target() {
  local t="$1"
  [ -z "$t" ] && { echo "dns 127.0.0.1"; return; }
  is_port "$t" && { echo "proxy 127.0.0.1:$t"; return; }
  case "$t" in
    *:*)
      # ปล่อยให้ผ่านทั้งที่พอร์ตไม่ใช่ตัวเลข = เขียน routes.json เสียแบบเงียบ ๆ
      is_port "${t##*:}" && [ -n "${t%:*}" ] && { echo "proxy $t"; return; }
      echo "invalid"; return;;
  esac
  is_ipv4 "$t" && { echo "dns $t"; return; }
  echo "invalid"
}

cmd_proxy() {
  case "${1:-status}" in
    install)  proxy_install;;
    uninstall) proxy_uninstall;;
    start)    launchctl kickstart -k "gui/$UID/$AGENT_LABEL" 2>/dev/null && ok "สั่ง start แล้ว" \
                || err "ยังไม่ได้ติดตั้ง — รัน 'dnsdev proxy install' ก่อน";;
    stop)     launchctl bootout "gui/$UID/$AGENT_LABEL" 2>/dev/null && ok "หยุดแล้ว" \
                || warn "ไม่ได้รันอยู่";;
    log)      [ -f "$PROXY_LOG" ] && tail -n "${2:-40}" "$PROXY_LOG" || info "ยังไม่มี log";;
    status)   proxy_status;;
    *)        err "ไม่รู้จัก: dnsdev proxy $1"; return 1;;
  esac
}

proxy_install() {
  local src; src="$(find_daemon)" || {
    err "หา dnsdevd ไม่เจอ — build ก่อนด้วย  app/build.sh"; return 1; }

  local https http; read -r https http <<<"$(proxy_ports)"
  local holder
  holder="$(lsof -nP -iTCP:"$https" -sTCP:LISTEN 2>/dev/null | awk 'NR==2{print $1" (pid "$2")"}')"
  if [ -n "$holder" ] && ! proxy_running; then
    err ":$https ถูก $holder ยึดอยู่ — dnsdevd จะผูกไม่ได้"
    info "ย้ายตัวนั้นไปพอร์ตอื่น หรือให้ dnsdev ใช้พอร์ตอื่นโดยแก้ \"https\" ใน $ROUTES"
    return 1
  fi

  mkdir -p "$(dirname "$DAEMON_INSTALLED")" "$STATE" "$HOME/Library/LaunchAgents"
  # คัดลอกจริง ไม่ทำ symlink — ถ้ารีโปอยู่บนวอลุมที่ไม่ได้ mount launchd จะหาไม่เจอ
  cp -f "$src" "$DAEMON_INSTALLED" && chmod 755 "$DAEMON_INSTALLED"
  ok "ติดตั้ง dnsdevd: $DAEMON_INSTALLED"

  cat > "$AGENT_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>$AGENT_LABEL</string>
	<key>ProgramArguments</key>
	<array><string>$DAEMON_INSTALLED</string></array>
	<key>RunAtLoad</key><true/>
	<key>KeepAlive</key><true/>
	<key>StandardOutPath</key><string>$PROXY_LOG</string>
	<key>StandardErrorPath</key><string>$PROXY_LOG</string>
	<key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
PLIST
  launchctl bootout "gui/$UID/$AGENT_LABEL" 2>/dev/null
  if launchctl bootstrap "gui/$UID" "$AGENT_PLIST" 2>/dev/null; then
    ok "LaunchAgent: $AGENT_PLIST"
  else
    err "bootstrap ไม่สำเร็จ"; return 1
  fi
  sleep 1
  echo; proxy_status
  echo
  if ! ca_trusted; then
    warn "CA ยังไม่ถูกเชื่อถือ — browser จะขึ้นเตือน cert"
    info "รัน:  dnsdev trust"
  fi
}

proxy_uninstall() {
  launchctl bootout "gui/$UID/$AGENT_LABEL" 2>/dev/null && ok "หยุด agent แล้ว" || info "ไม่ได้รันอยู่"
  rm -f "$AGENT_PLIST" && ok "ลบ $AGENT_PLIST"
  rm -f "$DAEMON_INSTALLED" && ok "ลบ $DAEMON_INSTALLED"
  info "CA กับ routes.json ยังอยู่ที่ $STATE — ลบเองได้ถ้าไม่ใช้แล้ว"
}

proxy_status() {
  local https http; read -r https http <<<"$(proxy_ports)"
  if proxy_running; then
    ok "dnsdevd ทำงานอยู่  (pid $(pgrep -f "$DAEMON_INSTALLED" | head -1))"
  else
    [ -f "$AGENT_PLIST" ] && err "ติดตั้งแล้วแต่ไม่ได้รัน — ดู 'dnsdev proxy log'" \
                          || info "ยังไม่ได้ติดตั้ง — 'dnsdev proxy install'"
  fi
  local n=0
  [ -f "$ROUTES" ] && n="$(DNSDEV_FILE="$ROUTES" py -c 'import json,os;print(len(json.load(open(os.environ["DNSDEV_FILE"])).get("routes",[])))' 2>/dev/null || echo 0)"
  info "ฟัง https :$https · http :$http · $n route"
  ca_trusted && ok "CA เชื่อถือแล้ว (System keychain)" || warn "CA ยังไม่ถูกเชื่อถือ — 'dnsdev trust'"
}

ca_trusted() {
  [ -f "$CA_PEM" ] || return 1
  # เทียบด้วย fingerprint — ชื่อ CA ซ้ำกันได้ แต่ลายนิ้วมือไม่ซ้ำ
  local fp
  fp="$(/usr/bin/openssl x509 -in "$CA_PEM" -noout -fingerprint -sha1 2>/dev/null | cut -d= -f2 | tr -d ':')"
  [ -n "$fp" ] || return 1
  security find-certificate -a -Z /Library/Keychains/System.keychain 2>/dev/null \
    | grep -q "SHA-1 hash: $fp"
}

ensure_ca() {
  [ -f "$CA_PEM" ] && return 0
  local d; d="$(find_daemon)" || { err "หา dnsdevd ไม่เจอ — build ก่อน"; return 1; }
  "$d" --ensure-ca >/dev/null || return 1
}

cmd_trust() {
  ensure_ca || return 1
  if ca_trusted; then ok "CA ถูกเชื่อถืออยู่แล้ว"; return 0; fi
  info "จะเพิ่ม CA ของ dnsdev เข้า System keychain — ต้องใส่รหัสผ่าน"
  info "  $CA_PEM"
  if sudo security add-trusted-cert -d -r trustRoot -p ssl \
       -k /Library/Keychains/System.keychain "$CA_PEM"; then
    ok "เชื่อถือแล้ว — https://<โดเมนของคุณ> จะไม่ขึ้นเตือนอีก"
  else
    err "เพิ่มไม่สำเร็จ"; return 1
  fi
}

cmd_untrust() {
  [ -f "$CA_PEM" ] || { err "ไม่มี $CA_PEM"; return 1; }
  sudo security remove-trusted-cert -d "$CA_PEM" 2>/dev/null \
    && ok "เอา CA ออกจาก trust store แล้ว" || err "เอาออกไม่สำเร็จ"
}

usage() {
  cat <<EOF
${B}dnsdev${N} — จัดการ local dev DNS ให้จบในคำสั่งเดียว

  ${B}dnsdev add${N} <domain> [ปลายทาง]  เพิ่ม wildcard zone + route ของ proxy
  ${B}dnsdev rm${N} <domain>         ลบ zone + route (ลบ resolver ถ้าไม่มีใครใช้ TLD แล้ว)
  ${B}dnsdev ls${N}                  ดูทุกโดเมน ทั้งชั้น DNS และชั้น proxy
  ${B}dnsdev test${N} <domain>       ทดสอบ 2 ชั้น ด้วย subdomain สุ่ม
  ${B}dnsdev doctor${N}              ตรวจทั้งระบบ หา resolver กำพร้า / hosts ที่ทับ zone
  ${B}dnsdev restart${N}             restart dnsmasq + flush cache

${B}ชั้น https${N} (ไม่ต้องพิมพ์พอร์ต)
  ${B}dnsdev proxy install${N}       ติดตั้ง dnsdevd เป็น LaunchAgent แล้วเริ่มรัน
  ${B}dnsdev proxy status${N}        ดูว่ารันอยู่ไหม ฟังพอร์ตอะไร CA เชื่อถือหรือยัง
  ${B}dnsdev proxy log${N} [n]       ดู log ของ proxy
  ${B}dnsdev proxy stop|start${N}    หยุด / เริ่มใหม่
  ${B}dnsdev proxy uninstall${N}     ถอด LaunchAgent ออก
  ${B}dnsdev trust${N}               เพิ่ม CA เข้า System keychain (ครั้งเดียว ต้องใส่รหัส)
  ${B}dnsdev untrust${N}             เอา CA ออกจาก trust store

${D}ปลายทางของ add ตีความตามรูปแบบ${N}
  dnsdev add myapp.test 3000            https://myapp.test → 127.0.0.1:3000
  dnsdev add myapp.test                 DNS อย่างเดียว ชี้ 127.0.0.1
  dnsdev add vm.foo.test 10.100.0.9     DNS ชี้ IP นั้นตรง ๆ (กฎยาวกว่าชนะเสมอ)
  dnsdev add api.test 10.100.0.9:8080   proxy ข้ามเครื่องไปพอร์ตนั้น
  dnsdev add --pass vm.test 127.0.0.1:8443
                                        ส่ง TLS ดิบต่อ — ปลายทางถือ cert เอง
                                        (ใช้กับ VM/คอนเทนเนอร์ที่มี cert อยู่แล้ว)

${D}เพิ่ม subdomain ของ zone ที่มีอยู่แล้ว (เช่น api.myapp.test)
ไม่ต้องทำอะไรเลย ทั้ง DNS และ proxy ครอบทุกชั้นให้แล้ว${N}
EOF
}

case "${1:-}" in
  add)     shift; cmd_add "$@";;
  rm|del|remove) shift; cmd_rm "$@";;
  ls|list) cmd_ls;;
  test|check) shift; cmd_test "$@";;
  doctor|status) cmd_doctor;;
  restart|reload) reload;;
  proxy)   shift; cmd_proxy "$@";;
  trust)   cmd_trust;;
  untrust) cmd_untrust;;
  -h|--help|help|"") usage;;
  *) err "ไม่รู้จักคำสั่ง: $1"; echo; usage; exit 1;;
esac
