#!/usr/bin/env python3
"""dnsdev-ui — หน้าเว็บจัดการ local dev DNS (dnsmasq + /etc/resolver)

รันแล้วเปิด browser ให้เอง  ปิดด้วย Ctrl+C
ทำงานได้ทั้ง Intel (/usr/local) และ Apple Silicon (/opt/homebrew)

งานที่ต้องสิทธิ์ root (แตะ /etc/resolver, restart dnsmasq) จะรวบเป็นชุดเดียว
แล้วขอผ่าน dialog ของ macOS — กรอกรหัสครั้งเดียวต่อหนึ่งการกระทำ
เซิร์ฟเวอร์เองรันด้วยสิทธิ์ผู้ใช้ปกติ ไม่ได้รันเป็น root
"""
import http.server, json, os, re, secrets, shutil, socket, subprocess, sys, tempfile, threading, time, webbrowser
from pathlib import Path

RESOLVER = Path("/etc/resolver")
SERVICE = "homebrew.mxcl.dnsmasq"
TOKEN = secrets.token_urlsafe(24)


def brew_prefix() -> Path:
    cands = []
    if shutil.which("brew"):
        try:
            cands.append(subprocess.run(["brew", "--prefix"], capture_output=True, text=True,
                                        timeout=10).stdout.strip())
        except Exception:
            pass
    cands += ["/opt/homebrew", "/usr/local"]
    for c in cands:
        if c and (Path(c) / "etc/dnsmasq.conf").is_file():
            return Path(c)
    for c in cands:
        if c and (Path(c) / "sbin/dnsmasq").exists():
            return Path(c)
    sys.exit("หา dnsmasq ไม่เจอ — ลง 'brew install dnsmasq' ก่อน")


PREFIX = brew_prefix()
ZONED = PREFIX / "etc/dnsmasq.d"
CONF = PREFIX / "etc/dnsmasq.conf"
BIN = PREFIX / "sbin/dnsmasq"

RESERVED = {
    "local": ("error", ".local ใช้ไม่ได้ — macOS ส่งไป mDNSResponder (Bonjour) เสมอ "
                       "query ไม่มีทางถึง dnsmasq  ใช้ .test แทน"),
    "dev": ("warn", ".dev เป็น gTLD จริงของ Google อยู่ใน HSTS preload "
                    "browser บังคับ https ต้องมี cert"),
    "localhost": ("warn", ".localhost macOS resolve ให้เองทุก subdomain อยู่แล้ว "
                          "ไม่ต้องใช้ dnsmasq (แต่ชี้ได้แค่ 127.0.0.1)"),
    "test": ("ok", "สงวนถาวรตาม RFC 6761 ปลอดภัยที่สุด"),
}
DOMAIN_RE = re.compile(r"^(?!-)[A-Za-z0-9-]{1,63}(?<!-)(\.(?!-)[A-Za-z0-9-]{1,63}(?<!-))+$")
IP_RE = re.compile(r"^\d{1,3}(\.\d{1,3}){3}$")


# ---------- privileged ----------
def run_admin(cmd: str, prompt: str) -> tuple[bool, str]:
    """รันคำสั่งเดียว (รวบหลายงานด้วย && ได้) ผ่าน dialog ขอสิทธิ์ของ macOS"""
    esc = cmd.replace("\\", "\\\\").replace('"', '\\"')
    pr = prompt.replace("\\", "\\\\").replace('"', '\\"')
    script = f'do shell script "{esc}" with prompt "{pr}" with administrator privileges'
    p = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if p.returncode != 0:
        err = p.stderr.strip()
        if "-128" in err:
            return False, "ยกเลิกการกรอกรหัส"
        return False, err or "คำสั่งล้มเหลว"
    return True, p.stdout.strip()


def reload_cmds() -> list[str]:
    return [f"launchctl kickstart -k system/{SERVICE}",
            "dscacheutil -flushcache",
            "killall -HUP mDNSResponder"]


# ---------- state ----------
def zone_path(domain: str) -> Path:
    return ZONED / (domain.replace(".", "_") + ".conf")


def read_zones() -> list[dict]:
    out = []
    if not ZONED.is_dir():
        return out
    for f in sorted(ZONED.glob("*.conf")):
        try:
            text = f.read_text(errors="replace")
        except OSError:
            continue
        for m in re.finditer(r"^address=/([^/]+)/(\S+)\s*$", text, re.M):
            d, ip = m.group(1), m.group(2)
            out.append({"domain": d, "ip": ip, "file": str(f),
                        "resolver": resolver_for(d)})
    return out


def resolver_for(domain: str) -> str | None:
    probe = domain
    while probe:
        if (RESOLVER / probe).is_file():
            return probe
        if "." not in probe:
            return None
        probe = probe.split(".", 1)[1]
    return None


def hosts_shadow(domain: str) -> list[str]:
    hits = []
    try:
        for line in Path("/etc/hosts").read_text(errors="replace").splitlines():
            line = line.split("#", 1)[0].strip()
            if not line:
                continue
            for name in line.split()[1:]:
                if name == domain or name.endswith("." + domain):
                    hits.append(name)
    except OSError:
        pass
    return sorted(set(hits))


def dnsmasq_running() -> int | None:
    p = subprocess.run(["pgrep", "-f", f"{PREFIX}.*dnsmasq"], capture_output=True, text=True)
    pids = [x for x in p.stdout.split() if x.isdigit()]
    return int(pids[0]) if pids else None


def syntax_ok() -> tuple[bool, str]:
    p = subprocess.run([str(BIN), "--test", "-C", str(CONF), "-7", f"{ZONED},*.conf"],
                       capture_output=True, text=True)
    return p.returncode == 0, (p.stderr or p.stdout).strip()


def probe(domain: str) -> dict:
    """ทดสอบ 2 ชั้นด้วย subdomain สุ่ม เพื่อพิสูจน์ว่า wildcard ทำงานจริง
    ไม่ใช่บังเอิญมีบรรทัดค้างใน /etc/hosts"""
    name = f"wildcard-check-{secrets.randbelow(90000) + 10000}.{domain}"
    d = subprocess.run(["dig", "+short", "+time=2", "+tries=1", "@127.0.0.1", name],
                       capture_output=True, text=True).stdout.strip().splitlines()
    s = subprocess.run(["dscacheutil", "-q", "host", "-a", "name", name],
                       capture_output=True, text=True).stdout
    sm = re.search(r"^ip_address:\s*(\S+)", s, re.M)
    return {"probe": name,
            "dnsmasq": d[0] if d else None,
            "system": sm.group(1) if sm else None}


def orphan_resolvers() -> list[str]:
    if not RESOLVER.is_dir():
        return []
    zones = [z["domain"] for z in read_zones()]
    out = []
    for f in sorted(RESOLVER.iterdir()):
        if not f.is_file():
            continue
        n = f.name
        if not any(z == n or z.endswith("." + n) for z in zones):
            out.append(n)
    return out


def snapshot() -> dict:
    zones = read_zones()
    ok, msg = syntax_ok()
    pid = dnsmasq_running()
    return {
        "prefix": str(PREFIX), "arch": os.uname().machine,
        "running": pid, "syntax_ok": ok, "syntax_msg": msg,
        "conf_dir": bool(re.search(r"^\s*conf-dir=", CONF.read_text(errors="replace"), re.M))
                    if CONF.is_file() else False,
        "zones": [dict(z, shadow=hosts_shadow(z["domain"])) for z in zones],
        "orphans": orphan_resolvers(),
        "proxy": proxy_state(),
    }


# ---------- actions ----------
def act_add(domain: str, ip: str) -> dict:
    domain = domain.strip().strip(".").lower()
    ip = (ip or "127.0.0.1").strip()
    if not DOMAIN_RE.match(domain):
        return {"ok": False, "msg": f"รูปแบบโดเมนไม่ถูกต้อง: {domain}"}
    if not IP_RE.match(ip) or any(int(o) > 255 for o in ip.split(".")):
        return {"ok": False, "msg": f"IP ไม่ถูกต้อง: {ip}"}
    tld = domain.rsplit(".", 1)[-1]
    level, note = RESERVED.get(tld, ("warn", f".{tld} ไม่ใช่ TLD ที่สงวนไว้ "
                                             "อาจถูกขายเป็นโดเมนจริงในอนาคต — .test ปลอดภัยกว่า"))
    if level == "error":
        return {"ok": False, "msg": note}

    zp = zone_path(domain)
    prev = zp.read_text(errors="replace") if zp.is_file() else None
    zp.write_text(f"# {domain} — wildcard ครอบทุก subdomain ทุกชั้น\n"
                  f"# สร้างโดย dnsdev-ui\n"
                  f"address=/{domain}/{ip}\n")

    ok, msg = syntax_ok()
    if not ok:
        zp.write_text(prev) if prev is not None else zp.unlink(missing_ok=True)
        return {"ok": False, "msg": f"config syntax ผิด ยกเลิกแล้ว: {msg}"}

    cmds = []
    existing = resolver_for(domain)
    if not existing:
        cmds.append(f"mkdir -p {RESOLVER} && printf 'nameserver 127.0.0.1\\n' > {RESOLVER}/{tld}")
    cmds += reload_cmds()
    good, out = run_admin(" && ".join(cmds), f"dnsdev — เพิ่ม {domain}")
    if not good:
        zp.write_text(prev) if prev is not None else zp.unlink(missing_ok=True)
        return {"ok": False, "msg": f"ย้อนกลับแล้ว: {out}"}

    res = probe(domain)
    warn = None if level == "ok" else note
    return {"ok": True, "msg": f"เพิ่ม {domain} → {ip} แล้ว", "probe": res,
            "warn": warn, "new_resolver": None if existing else tld,
            "shadow": hosts_shadow(domain)}


def act_remove(domain: str) -> dict:
    zp = zone_path(domain)
    if not zp.is_file():
        return {"ok": False, "msg": f"ไม่มี zone: {domain}"}
    backup = zp.read_text(errors="replace")
    zp.unlink()

    tld = domain.rsplit(".", 1)[-1]
    cmds = []
    if (RESOLVER / tld).is_file() and not any(
            z["domain"] == tld or z["domain"].endswith("." + tld) for z in read_zones()):
        cmds.append(f"rm -f {RESOLVER}/{tld}")
    cmds += reload_cmds()
    good, out = run_admin(" && ".join(cmds), f"dnsdev — ลบ {domain}")
    if not good:
        zp.write_text(backup)
        return {"ok": False, "msg": f"ย้อนกลับแล้ว: {out}"}
    return {"ok": True, "msg": f"ลบ {domain} แล้ว"}


def act_restart() -> dict:
    good, out = run_admin(" && ".join(reload_cmds()), "dnsdev — restart dnsmasq")
    return {"ok": good, "msg": "restart + flush cache แล้ว" if good else out}


# ---------- ชั้น https (dnsdevd) ----------
# ชั้นนี้แทบไม่ต้องใช้ root: LaunchAgent เป็นของ user และ macOS ยอมให้ผูก
# พอร์ตต่ำกว่า 1024 โดยไม่ต้องเป็น root  เหลืองานเดียวที่ขอรหัส คือเอา CA
# เข้า System keychain
STATE = Path.home() / ".config/dnsdev"
ROUTES = STATE / "routes.json"
CA_PEM = STATE / "ca/ca.pem"
PROXY_LOG = STATE / "proxy.log"
AGENT_LABEL = "local.dnsdev.proxy"
AGENT_PLIST = Path.home() / f"Library/LaunchAgents/{AGENT_LABEL}.plist"
DAEMON = Path.home() / ".local/libexec/dnsdevd"


def find_daemon() -> Path | None:
    """ตัวที่ติดตั้งแล้วมาก่อน แล้วค่อยไล่หาในรีโป (ตอน dev)"""
    here = Path(__file__).resolve().parent
    for c in (DAEMON, here.parent / "proxy/dnsdevd", here / "proxy/dnsdevd"):
        if c.is_file() and os.access(c, os.X_OK):
            return c
    return None


def read_routes() -> tuple[int, int, list[dict]]:
    try:
        cfg = json.loads(ROUTES.read_text())
    except Exception:
        return 443, 80, []
    rs = []
    for r in cfg.get("routes") or []:
        if isinstance(r, dict) and r.get("host") and r.get("to"):
            rs.append({"host": r["host"], "to": r["to"],
                       "passthrough": r.get("mode") == "passthrough"})
    return int(cfg.get("https", 443)), int(cfg.get("http", 80)), sorted(rs, key=lambda r: r["host"])


def write_routes(https: int, http: int, routes: list[dict]) -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    body = {"https": https, "http": http, "routes": []}
    for r in sorted(routes, key=lambda r: r["host"]):
        e = {"host": r["host"], "to": r["to"]}
        if r.get("passthrough"):
            e["mode"] = "passthrough"
        body["routes"].append(e)
    # เขียนไฟล์ชั่วคราวในโฟลเดอร์เดียวกันแล้ว rename ทับ — dnsdevd เฝ้าโฟลเดอร์อยู่
    # จะเห็นการเปลี่ยนครั้งเดียวจบ ไม่ใช่เห็นไฟล์ครึ่ง ๆ กลาง ๆ
    fd, tmp = tempfile.mkstemp(dir=str(STATE))
    with os.fdopen(fd, "w") as fh:
        json.dump(body, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    os.replace(tmp, ROUTES)


def proxy_pid() -> int | None:
    p = subprocess.run(["pgrep", "-f", str(DAEMON)], capture_output=True, text=True)
    out = p.stdout.split()
    return int(out[0]) if out else None


def ca_trusted() -> bool:
    """เทียบด้วย fingerprint — ชื่อ CA ซ้ำกันได้ ลายนิ้วมือไม่ซ้ำ"""
    if not CA_PEM.is_file():
        return False
    p = subprocess.run(["/usr/bin/openssl", "x509", "-in", str(CA_PEM),
                        "-noout", "-fingerprint", "-sha1"], capture_output=True, text=True)
    if p.returncode != 0 or "=" not in p.stdout:
        return False
    fp = p.stdout.split("=", 1)[1].strip().replace(":", "")
    q = subprocess.run(["/usr/bin/security", "find-certificate", "-a", "-Z",
                        "/Library/Keychains/System.keychain"], capture_output=True, text=True)
    return f"SHA-1 hash: {fp}" in q.stdout


def port_holder(port: int, ours: int | None) -> str | None:
    p = subprocess.run(["/usr/sbin/lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN"],
                       capture_output=True, text=True)
    for line in p.stdout.splitlines()[1:]:
        f = line.split()
        if len(f) < 2 or not f[1].isdigit():
            continue
        if ours and int(f[1]) == ours:
            return None
        return f"{f[0]} (pid {f[1]})"
    return None


def proxy_state() -> dict:
    https, http, routes = read_routes()
    pid = proxy_pid()
    return {
        "installed": AGENT_PLIST.is_file(),
        "pid": pid,
        "https": https, "http": http,
        "routes": routes,
        "ca_exists": CA_PEM.is_file(),
        "ca_trusted": ca_trusted(),
        "port_holder": port_holder(https, pid),
        "has_daemon": find_daemon() is not None,
    }


def ensure_ca() -> bool:
    if CA_PEM.is_file():
        return True
    d = find_daemon()
    return bool(d) and subprocess.run([str(d), "--ensure-ca"], capture_output=True).returncode == 0


PLIST_BODY = """<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
\t<key>Label</key><string>{label}</string>
\t<key>ProgramArguments</key>
\t<array><string>{daemon}</string></array>
\t<key>RunAtLoad</key><true/>
\t<key>KeepAlive</key><true/>
\t<key>StandardOutPath</key><string>{log}</string>
\t<key>StandardErrorPath</key><string>{log}</string>
\t<key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
"""


def act_proxy_install() -> dict:
    src = find_daemon()
    if not src:
        return {"ok": False, "msg": "หา dnsdevd ไม่เจอ — build ก่อนด้วย app/build.sh"}
    st = proxy_state()
    if st["port_holder"]:
        return {"ok": False,
                "msg": f":{st['https']} ถูก {st['port_holder']} ยึดอยู่ — "
                       f"ย้ายตัวนั้น หรือเปลี่ยนพอร์ตใน routes.json"}
    ensure_ca()
    DAEMON.parent.mkdir(parents=True, exist_ok=True)
    STATE.mkdir(parents=True, exist_ok=True)
    AGENT_PLIST.parent.mkdir(parents=True, exist_ok=True)
    # คัดลอกจริง ไม่ทำ symlink — ถ้ารีโปอยู่บนวอลุมที่ไม่ได้ mount launchd จะหาไม่เจอ
    shutil.copyfile(src, DAEMON)
    DAEMON.chmod(0o755)
    AGENT_PLIST.write_text(PLIST_BODY.format(label=AGENT_LABEL, daemon=DAEMON, log=PROXY_LOG))
    uid = os.getuid()
    subprocess.run(["launchctl", "bootout", f"gui/{uid}/{AGENT_LABEL}"], capture_output=True)
    p = subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(AGENT_PLIST)],
                       capture_output=True, text=True)
    if p.returncode != 0:
        return {"ok": False, "msg": f"launchctl bootstrap ล้มเหลว: {p.stderr.strip()}"}
    time.sleep(1)
    return {"ok": True, "msg": "ติดตั้ง proxy แล้ว"
            + ("" if ca_trusted() else " — เหลือติดตั้ง cert อีกขั้น")}


def act_proxy_uninstall() -> dict:
    subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{AGENT_LABEL}"], capture_output=True)
    AGENT_PLIST.unlink(missing_ok=True)
    DAEMON.unlink(missing_ok=True)
    return {"ok": True, "msg": "ถอด proxy แล้ว — CA กับ route ยังอยู่"}


def act_proxy_restart() -> dict:
    p = subprocess.run(["launchctl", "kickstart", "-k", f"gui/{os.getuid()}/{AGENT_LABEL}"],
                       capture_output=True, text=True)
    return ({"ok": True, "msg": "restart proxy แล้ว"} if p.returncode == 0
            else {"ok": False, "msg": "restart ไม่สำเร็จ — ติดตั้งหรือยัง?"})


def act_trust() -> dict:
    if not ensure_ca():
        return {"ok": False, "msg": "สร้าง CA ไม่สำเร็จ — build dnsdevd หรือยัง?"}
    if ca_trusted():
        return {"ok": True, "msg": "cert ถูกติดตั้งอยู่แล้ว"}
    ok, msg = run_admin(
        f"security add-trusted-cert -d -r trustRoot -p ssl "
        f"-k /Library/Keychains/System.keychain {CA_PEM}",
        "dnsdev — ติดตั้ง cert ของ dnsdev เข้าเครื่อง")
    return {"ok": ok, "msg": "ติดตั้ง cert แล้ว — https ในเครื่องจะไม่ขึ้นเตือนอีก" if ok else msg}


def act_untrust() -> dict:
    ok, msg = run_admin(f"security remove-trusted-cert -d {CA_PEM}",
                        "dnsdev — เอา cert ของ dnsdev ออกจากเครื่อง")
    return {"ok": ok, "msg": "เอา cert ออกแล้ว" if ok else msg}


def act_route(domain: str, port: str) -> dict:
    domain = (domain or "").strip().strip(".").lower()
    port = (port or "").strip().lstrip(":")
    if not domain:
        return {"ok": False, "msg": "ต้องระบุโดเมน"}
    https, http, routes = read_routes()
    routes = [r for r in routes if r["host"] != domain]
    if port:
        if not port.isdigit() or not (1 <= int(port) <= 65535):
            return {"ok": False, "msg": f"พอร์ตไม่ถูกต้อง: {port}"}
        routes.append({"host": domain, "to": f"127.0.0.1:{int(port)}", "passthrough": False})
        msg = f"https://{domain} → :{int(port)}"
    else:
        msg = f"เอา {domain} ออกจาก proxy แล้ว"
    write_routes(https, http, routes)
    return {"ok": True, "msg": msg}


# ---------- HTTP ----------
class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def _send(self, code, body: bytes, ctype):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _json(self, obj, code=200):
        self._send(code, json.dumps(obj).encode(), "application/json; charset=utf-8")

    def _authed(self) -> bool:
        # กัน CSRF: เว็บอื่นใน browser เดียวกันยิง POST มาที่ 127.0.0.1 ได้
        # ถ้าไม่มี token ป้องกันไว้ จึงบังคับ header ที่เว็บอื่นอ่าน token ไม่ได้
        if self.headers.get("X-Token") != TOKEN:
            self._json({"ok": False, "msg": "token ไม่ถูกต้อง"}, 403)
            return False
        return True

    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path == "/":
            self._send(200, PAGE.encode(), "text/html; charset=utf-8")
        elif path == "/api/state":
            if not self._authed():
                return
            self._json(snapshot())
        else:
            self._send(404, b"not found", "text/plain")

    def do_POST(self):
        if not self._authed():
            return
        n = int(self.headers.get("Content-Length") or 0)
        try:
            data = json.loads(self.rfile.read(n) or b"{}")
        except json.JSONDecodeError:
            return self._json({"ok": False, "msg": "payload ไม่ถูกต้อง"}, 400)
        path = self.path.split("?", 1)[0]
        try:
            if path == "/api/add":
                self._json(act_add(data.get("domain", ""), data.get("ip", "")))
            elif path == "/api/remove":
                self._json(act_remove(data.get("domain", "")))
            elif path == "/api/restart":
                self._json(act_restart())
            elif path == "/api/test":
                self._json({"ok": True, "probe": probe(data.get("domain", ""))})
            elif path == "/api/route":
                self._json(act_route(data.get("domain", ""), data.get("port", "")))
            elif path == "/api/proxy":
                op = data.get("op", "")
                self._json({"install": act_proxy_install, "uninstall": act_proxy_uninstall,
                            "restart": act_proxy_restart}.get(op, lambda: {
                                "ok": False, "msg": f"ไม่รู้จัก op: {op}"})())
            elif path == "/api/trust":
                self._json(act_untrust() if data.get("off") else act_trust())
            else:
                self._json({"ok": False, "msg": "ไม่รู้จัก endpoint"}, 404)
        except Exception as e:
            self._json({"ok": False, "msg": f"{type(e).__name__}: {e}"}, 500)


def free_port(start=7654) -> int:
    for p in range(start, start + 40):
        with socket.socket() as s:
            try:
                s.bind(("127.0.0.1", p))
                return p
            except OSError:
                continue
    sys.exit("หาพอร์ตว่างไม่ได้")


def main():
    port = free_port()
    url = f"http://127.0.0.1:{port}/#{TOKEN}"
    srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
    print(f"\n  dnsdev-ui  →  {url}")
    print(f"  prefix: {PREFIX}  ({os.uname().machine})")
    print("  ปิดด้วย Ctrl+C\n")
    threading.Timer(0.4, lambda: webbrowser.open(url)).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("ปิดแล้ว")
        srv.shutdown()


