  $('#proxy').innerHTML = proxyCard(s.proxy);

  const z = $('#zones');
  if(!s.zones.length){
    z.innerHTML = '<div class="empty">ยังไม่มี zone — เพิ่มด้านบนได้เลย</div>';
  } else {
    z.innerHTML = s.zones.map(x => {
      const rb = x.resolver
        ? `<span class="badge b-ok">/etc/resolver/${esc(x.resolver)}</span>`
        : `<span class="badge b-err">ไม่มี resolver — ใช้ไม่ได้</span>`;
      const sh = x.shadow.length
        ? `<span class="badge b-warn">/etc/hosts ทับ ${x.shadow.length}</span>` : '';
      const rt = (s.proxy.routes || []).find(r => r.host === x.domain);
      const live = s.proxy.pid && s.proxy.ca_trusted;
      const pb = rt
        ? `<a class="badge ${live?'b-ok':'b-warn'}" href="https://${esc(x.domain)}" target="_blank"
             title="${live?'เปิด https://'+esc(x.domain):'proxy ยังไม่พร้อม — route นี้ยังไม่มีผล'}"
             style="text-decoration:none">https ${esc(shortTo(rt.to))}${rt.passthrough?' ⇢':''}</a>`
        : '';
      return `<div class="zone" data-d="${esc(x.domain)}">
        <div class="d">*.${esc(x.domain)}<small class="mono">→ ${esc(x.ip)}</small></div>
        ${pb}${rb}${sh}
        <button class="ghost act-port">${rt?'พอร์ต':'+ https'}</button>
        <button class="ghost act-test">ทดสอบ</button>
        <button class="ghost danger act-rm">ลบ</button></div>`;
    }).join('');
  }

  const d = [];
  if(!s.running) d.push(['err','dnsmasq ไม่ได้รัน — <code>sudo brew services start dnsmasq</code>']);
  if(!s.syntax_ok) d.push(['err','config syntax ผิด: '+esc(s.syntax_msg)]);
  if(!s.conf_dir) d.push(['err','dnsmasq.conf ไม่มี <code>conf-dir=</code> — ไฟล์ zone จะไม่ถูกอ่านเลย']);
  s.zones.filter(x=>!x.resolver).forEach(x =>
    d.push(['err',`<b>${esc(x.domain)}</b> ไม่มี /etc/resolver — dnsmasq ตอบถูกแต่ macOS ไม่ส่ง query มาให้ ลบแล้วเพิ่มใหม่เพื่อให้สร้างให้`]));
  s.zones.filter(x=>x.shadow.length).forEach(x =>
    d.push(['warn',`<b>${esc(x.domain)}</b> ถูก /etc/hosts ทับ (${x.shadow.map(esc).join(', ')}) — hosts ชนะ DNS เสมอ subdomain อื่นจะยังใช้ไม่ได้`]));
  s.orphans.forEach(o =>
    d.push(['warn',`<code>/etc/resolver/${esc(o)}</code> ไม่มี zone รองรับ — query จะวิ่งไป dnsmasq แล้ว forward ออก internet เปล่า ๆ ทำให้ช้า`]));
  const px = s.proxy;
  if(px.installed && !px.pid)
    d.push(['err','dnsdevd ไม่ได้รัน'+(px.port_holder?` — :${px.https} ถูก <code>${esc(px.port_holder)}</code> ยึดอยู่`:'')]);
  if(!px.installed && px.routes.length)
    d.push(['warn',`มี route ของ proxy อยู่ ${px.routes.length} อัน แต่ยังไม่ได้ติดตั้ง dnsdevd`]);
  if(px.pid && px.routes.some(r=>!r.passthrough) && !px.ca_trusted)
    d.push(['warn','cert ของ dnsdev ยังไม่ถูกติดตั้งในเครื่อง — browser จะเตือนทุกครั้งที่เปิด https']);
  $('#doctor').innerHTML = d.length
    ? d.map(([k,m])=>`<div class="note n-${k}">${m}</div>`).join('')
    : '<div class="note n-ok">ไม่พบปัญหา</div>';
}

