async function api(path, body){
  const r = await fetch(path, {
    method: body ? 'POST' : 'GET',
    headers: {'X-Token': TOKEN, 'Content-Type':'application/json'},
    body: body ? JSON.stringify(body) : undefined});
  return r.json();
}

function probeRow(p){
  const line = (label, val) => `<div><span class="badge ${val?'b-ok':'b-err'}">${val?'ผ่าน':'ไม่ผ่าน'}</span>
    <span>${label}</span><span class="mono" style="color:var(--dim)">${val?esc(val):'ไม่ตอบ'}</span></div>`;
  return `<div class="result">
    <div style="color:var(--dim);margin-bottom:6px">ยิง <span class="mono">${esc(p.probe)}</span>
      — ชื่อสุ่มที่ไม่เคยมีใน /etc/hosts</div>
    ${line('ชั้น dnsmasq', p.dnsmasq)}${line('ชั้นระบบ (ที่ app ใช้จริง)', p.system)}</div>`;
}

const shortTo = to => {
  const p = String(to).split(':');
  return (p.length === 2 && p[0] === '127.0.0.1') ? ':' + p[1] : to;
};

function proxyPill(px){
  if(!px.installed && !px.routes.length) return '';
  if(!px.installed) return '<span class="pill off">https ยังไม่ติดตั้ง</span>';
  if(!px.pid) return '<span class="pill off">https หยุด</span>';
  return px.ca_trusted
    ? `<span class="pill on">https :${px.https}</span>`
    : '<span class="pill off">https · ยังไม่มี cert</span>';
}

/// การ์ดนี้คือที่เดียวที่ควบคุมชั้น https ได้ครบ — ติดตั้ง/ถอด proxy กับ cert
function proxyCard(px){
  const rows = px.routes.length
    ? px.routes.map(r => `<div class="d" style="padding:2px 0">
        <span class="mono">https://${esc(r.host)}</span>
        <small class="mono">→ ${esc(r.to)}${r.passthrough?'  (passthrough)':''}</small></div>`).join('')
    : '<div class="empty" style="padding:8px 0">ยังไม่มี route — ใส่พอร์ตตอนเพิ่มโดเมน หรือกด <b>+ https</b> ที่แถว zone</div>';
  const btn = (cls, label, extra='') => `<button class="ghost ${cls}" ${extra}>${label}</button>`;
  const ctl = px.installed
    ? btn('act-px', px.pid ? 'restart proxy' : 'เริ่ม proxy', 'data-op="restart"')
      + btn('act-px danger', 'ถอด proxy', 'data-op="uninstall"')
    : btn('act-px', 'ติดตั้ง proxy', 'data-op="install"');
  const cert = px.ca_trusted
    ? btn('act-trust danger', 'เอา cert ออกจากเครื่อง', 'data-off="1"')
    : btn('act-trust', 'ติดตั้ง cert เข้าเครื่อง');
  const warn = !px.has_daemon
    ? '<div class="note n-err" style="margin-top:8px">หา <code>dnsdevd</code> ไม่เจอ — build ก่อนด้วย <code>app/build.sh</code></div>'
    : (px.port_holder
        ? `<div class="note n-warn" style="margin-top:8px">:${px.https} ถูก <code>${esc(px.port_holder)}</code> ยึดอยู่</div>`
        : '');
  return rows + `<div style="margin-top:10px;display:flex;gap:6px;flex-wrap:wrap">${ctl}${cert}</div>` + warn;
}

function render(s){
  $('#pills').innerHTML =
    `<span class="pill ${s.running?'on':'off'}">${s.running?'dnsmasq ทำงาน · pid '+s.running:'dnsmasq ไม่ได้รัน'}</span>
